{%- set ps = "(min-width:1100px) 17vw, 62vw" -%}
<main id="main" class="fg">

<svg class="fg-trail" viewBox="0 0 729 1474" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d="M162 244C190 243 228 252 252 270"/>
  <path d="M538 380C562 398 560 416 528 421S330 418 210 426C150 430 116 452 112 486C108 514 104 528 106 538"/>
