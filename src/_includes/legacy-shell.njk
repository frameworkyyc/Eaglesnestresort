<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="{% if site.production %}index, follow, max-image-preview:large{% else %}noindex, nofollow{% endif %}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:site_name" content="Eagle&#39;s Nest Resort">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_CA">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="https://www.eaglesnestresort.ca/images/eagles-nest-social-preview.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="images/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="images/apple-touch-icon.png">
<meta name="theme-color" content="#F3EEE1">
<meta name="color-scheme" content="light only">
{# Same font request and stylesheet as the existing pages, so the header and footer render exactly as they do today. #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bevan&family=Oswald:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/site.css?v=9b0bdf51">
<link rel="preload" href="/assets/fonts/roboto-serif-cond.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ assets.ttdCss }}">
<script type="application/ld+json">{{ jsonld | dump | safe }}</script>
</head>
<body>

{% include "partials/legacy-nav.html" %}
{{ content | safe }}
{% include "partials/legacy-footer.html" %}

<script src="js/site.js?v=9b0bdf51"></script>
<script src="{{ assets.ttdJs }}" defer></script>
</body>
</html>
